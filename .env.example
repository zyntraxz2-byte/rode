# Copy to .env and edit. Every value is optional except where noted.

# --- server ---
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data            # SQLite database + uploaded photos live here. Back this folder up.
APP_TIMEZONE=Asia/Colombo  # IANA zone used for "today" and past-time checks on the server
DEFAULT_CURRENCY=LKR       # used only the first time the database is created

# --- first administrator (only used when the database has no users) ---
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
# If empty, a random password is generated and printed once in the server log.
# Min 10 chars, must not contain the username. You are asked to change a generated one at first sign-in.
ADMIN_PASSWORD=

# --- behind a reverse proxy / HTTPS ---
# Number of proxies in front (1 for nginx/Caddy/Traefik), or "false" when exposed directly.
TRUST_PROXY=false
COOKIE_SECURE=auto         # auto | true | false  (auto = Secure flag when the request was HTTPS)
ENABLE_HSTS=false          # set true once HTTPS works end to end
ALLOWED_ORIGINS=           # extra trusted origins (comma separated), normally empty

# --- password-reset email (optional; leave SMTP_HOST empty to turn "Forgot password?" off) ---
# PUBLIC_URL is where users open the app; it is put in the emailed link (required in production).
PUBLIC_URL=                # e.g. https://rode.example.com   (no trailing slash)
SMTP_HOST=                 # e.g. smtp.gmail.com, smtp.sendgrid.net, email-smtp.eu-west-1.amazonaws.com
SMTP_PORT=587              # 587 (STARTTLS) or 465 (with SMTP_SECURE=true)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=                 # e.g. Rode <no-reply@rode.example.com>
RESET_TOKEN_MINUTES=60     # how long an emailed reset link stays valid

# --- sessions ---
SESSION_IDLE_HOURS=168     # sign out after this long without use
SESSION_MAX_DAYS=30        # hard limit regardless of use

# --- abuse protection ---
LOGIN_MAX_FAILURES=8       # failed sign-ins per IP+username before a lockout
LOGIN_WINDOW_MINUTES=15
LOGIN_IP_MAX_ATTEMPTS=40
CUSTOMER_MAX_ACTIVE_BOOKINGS=20
MAX_UPLOAD_MB=8

# --- optional: "Quick book" (speak or type a booking) ---
# Needs an Anthropic API key. Leave empty to hide the feature.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

LOG_LEVEL=info             # debug | info | warn | error | silent
